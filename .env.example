ANTHROPIC_KEY=your_anthropic_api_key_here

# From the Neon integration in Vercel's Storage marketplace
DATABASE_URL=your_neon_connection_string_here

# From the Vercel Blob store
BLOB_READ_WRITE_TOKEN=your_blob_read_write_token_here

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` when
# hitting /api/cron/process-pending. Any random string; set the same value
# as a Vercel env var. The cron endpoint refuses all requests without it.
CRON_SECRET=your_random_secret_here
